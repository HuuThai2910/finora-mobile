# Expo chỉ expose biến có tiền tố EXPO_PUBLIC_
# Địa chỉ Gateway: mọi service (user, loan, investment, payment, notification) đi chung một URL.
EXPO_PUBLIC_API_URL=http://192.168.1.141:8080/api/v1
# Địa chỉ gốc WebSocket của sổ lệnh thời gian thực (/ws/order-books/<id>). Gateway không chuyển tiếp WebSocket.
# Bỏ trống: lấy origin của EXPO_PUBLIC_API_URL (bản deploy: Caddy trên VM đưa /ws/* thẳng tới Investment).
# Chạy local: trỏ thẳng Investment, ví dụ ws://192.168.1.141:8084. Không mở được thì màn sổ lệnh tự hỏi lại 5 giây.
EXPO_PUBLIC_WS_BASE_URL=
EXPO_PUBLIC_APP_NAME=FINORA

# Miền chạy dữ liệu giả. Trang chủ không có miền riêng: giao dịch gần đây đọc lịch sử ví thật;
# feature loan-servicing luôn gọi Loan + Payment thật và không đọc cờ mock.
# Backend miền nào xong thì xoá tên miền đó khỏi danh sách.
# Product, Application, Contract và chấm điểm chính thức đều đi qua finora-loan.
# Market, danh mục và hợp đồng đầu tư đã có backend thật; chỉ giữ mock cho miền chưa triển khai.
#
# `auth` không còn dùng được: Loan Service đọc claim user_id trong access token thật
# để biết hồ sơ vay thuộc về ai, nên phiên giả sẽ bị từ chối.
# `notification` đã có backend thật (hộp thư, đã đọc, thông báo đẩy, cài đặt) nên không còn trong danh sách;
# thêm lại `notification` thì app không đăng ký thông báo đẩy với máy chủ.
EXPO_PUBLIC_MOCK_DOMAINS=

# Thông báo đẩy (finora-notification R7): EAS projectId của bản build, định danh công khai, không phải secret.
# Bỏ trống thì app báo "chưa cấu hình" và chỉ có thông báo trong app. Push từ xa cần development build trên máy thật
# (Expo Go không nhận push từ xa); backend mặc định NOTIFICATION_PUSH_PROVIDER=log chỉ giả lập việc gửi.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Bật lỗi giả cho một miền để xem màn báo lỗi khi demo, ví dụ: EXPO_PUBLIC_MOCK_FAIL=wallet
EXPO_PUBLIC_MOCK_FAIL=

# Kịch bản giả của miền đang mock (cách nhau dấu phẩy) để xem nhánh hiếm khi demo eKYC:
# ekyc-retake (bắt chụp lại mặt trước 2 lần → hiện nút "Chọn ảnh có sẵn"), ekyc-reject (thẻ hết hạn),
# ekyc-review (khuôn mặt vùng xám → chờ duyệt), ekyc-liveness-fail (tối → trượt → mặt không khớp → chờ duyệt).
# Chỉ có tác dụng khi `ekyc` nằm trong EXPO_PUBLIC_MOCK_DOMAINS.
EXPO_PUBLIC_MOCK_SCENARIOS=

# eKYC — nguồn chụp CCCD: in_app (camera trong app, mặc định) | system (app Camera của máy).
# Không có nút đổi nguồn cho người dùng; đổi biến này rồi chạy lại `npx expo start -c`.
EXPO_PUBLIC_EKYC_CAPTURE_SOURCE=in_app

# eKYC — chế độ quay liveness: video (mặc định) | stills (ép chụp ảnh liên tiếp để thử nhánh dự phòng
# trên máy vẫn quay video được; server chỉ cho kết quả tối đa "chờ duyệt" ở chế độ này).
EXPO_PUBLIC_EKYC_LIVENESS_CAPTURE=video

# Phải khớp finora.loan.pricing-disclosure-version của finora-loan.
EXPO_PUBLIC_PRICING_DISCLOSURE_VERSION=RATE_DISCLOSURE_V2

# Mở ứng dụng VNPT SmartCA sau khi backend tạo giao dịch ký. Đây là URL công khai, không phải secret.
# Demo/UAT: vnptsmartcademo:// | Production: vnptsmartca://
EXPO_PUBLIC_SMARTCA_APP_URL=vnptsmartcademo://

# Tài khoản BORROWER/INVESTOR dùng riêng khi chạy local để bấm điền nhanh ở màn đăng nhập.
# Chỉ điền tài khoản sandbox có thể hủy; không dùng tài khoản/mật khẩu thật và không đưa vào production build.
# Giá trị thật đặt trong `.env` đã được Git bỏ qua.
EXPO_PUBLIC_TEST_BORROWER_1_EMAIL=
EXPO_PUBLIC_TEST_BORROWER_1_PASSWORD=
EXPO_PUBLIC_TEST_BORROWER_2_EMAIL=
EXPO_PUBLIC_TEST_BORROWER_2_PASSWORD=
EXPO_PUBLIC_TEST_BORROWER_3_EMAIL=
EXPO_PUBLIC_TEST_BORROWER_3_PASSWORD=
EXPO_PUBLIC_TEST_INVESTOR_1_EMAIL=
EXPO_PUBLIC_TEST_INVESTOR_1_PASSWORD=
EXPO_PUBLIC_TEST_INVESTOR_2_EMAIL=
EXPO_PUBLIC_TEST_INVESTOR_2_PASSWORD=
EXPO_PUBLIC_TEST_INVESTOR_3_EMAIL=
EXPO_PUBLIC_TEST_INVESTOR_3_PASSWORD=
