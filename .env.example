# Expo chỉ expose biến có tiền tố EXPO_PUBLIC_
EXPO_PUBLIC_API_URL=http://localhost:8081/api/v1
EXPO_PUBLIC_APP_NAME=FINORA

# Xác thực và hồ sơ người dùng do finora-user phục vụ, đi qua Gateway (cổng 8080),
# khác cổng với Loan Service ở EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_AUTH_API_URL=http://localhost:8080/api/v1

# Miền chạy dữ liệu giả. Backend miền nào xong thì xoá tên miền đó khỏi danh sách.
# Product, Application, Contract và chấm điểm chính thức đều đi qua finora-loan.
# `signature` ở đây chỉ còn dùng cho hợp đồng đầu tư demo; hợp đồng vay gọi Loan Service.
#
# `auth` không còn dùng được: Loan Service đọc claim user_id trong access token thật
# để biết hồ sơ vay thuộc về ai, nên phiên giả sẽ bị từ chối.
EXPO_PUBLIC_MOCK_DOMAINS=wallet,invest,market,notification,signature,servicing

# Bật lỗi giả cho một miền để xem màn báo lỗi khi demo, ví dụ: EXPO_PUBLIC_MOCK_FAIL=wallet
EXPO_PUBLIC_MOCK_FAIL=

# Phải khớp finora.loan.pricing-disclosure-version của finora-loan.
EXPO_PUBLIC_PRICING_DISCLOSURE_VERSION=RATE_DISCLOSURE_V1
