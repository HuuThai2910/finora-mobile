{
  "expo": {
    "name": "FINORA",
    "slug": "finora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "finora",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finora.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "vnptsmartca",
          "vnptsmartcademo"
        ]
      }
    },
    "android": {
      "package": "com.finora.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "FINORA dùng camera để chụp CCCD và xác minh khuôn mặt khi định danh."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#1d4ed8"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#1d4ed8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9da461f6-43c9-4da9-b4b0-2f9a32dce4b3"
      }
    },
    "owner": "ngochai147"
  }
}
